{
  "name": "software-engineering-guide.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Software Engineering Guide — published website (SvelteKit + Lily Design System)",
  "scripts": {
    "dev": "node scripts/generate-manifest.mjs && vite dev",
    "build": "node scripts/generate-manifest.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "manifest": "node scripts/generate-manifest.mjs",
    "content": "node scripts/sync-content.mjs && node scripts/generate-manifest.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "mdsvex": "^0.12.3",
    "svelte": "^5.25.0",
    "svelte-check": "^4.2.0",
    "typescript": "^5.8.0",
    "unist-util-visit": "^5.0.0",
    "vite": "^6.2.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": ["esbuild"],
    "onlyBuiltDependencies": ["esbuild"]
  }
}
