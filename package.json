{
  "name": "software-engineering-guide.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Software Engineering Guide — published website (SvelteKit + Lily Design System)",
  "scripts": {
    "dev": "node scripts/generate-manifest.mjs && vite dev",
    "build": "node scripts/generate-manifest.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "manifest": "node scripts/generate-manifest.mjs",
    "content": "node scripts/sync-content.mjs && node scripts/generate-manifest.mjs",
    "postinstall": "node scripts/fix-lily-picker-resolution.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "mdsvex": "^0.12.8",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^6.4.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@lilydesignsystem/svelte-locale-picker": "0.1.2",
    "@lilydesignsystem/svelte-picker-bar": "^0.1.0",
    "@lilydesignsystem/svelte-share-picker": "0.1.2",
    "@lilydesignsystem/svelte-text-size-picker": "0.1.2",
    "@lilydesignsystem/svelte-theme-picker": "0.1.2"
  }
}
