{
  "name": "software-engineering-guide.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Software Engineering Guide — published website (SvelteKit + Lily Design System)",
  "scripts": {
    "dev": "node scripts/copy-lily-themes.mjs && node scripts/generate-manifest.mjs && vite dev",
    "build": "node scripts/copy-lily-themes.mjs && node scripts/generate-manifest.mjs && vite build && node scripts/build-search-index.mjs build en-us && node scripts/generate-sitemap.mjs build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "manifest": "node scripts/generate-manifest.mjs",
    "themes": "node scripts/copy-lily-themes.mjs",
    "content": "node scripts/sync-content.mjs && node scripts/generate-manifest.mjs",
    "postinstall": "node scripts/fix-lily-picker-resolution.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "mdsvex": "^0.12.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@lilydesignsystem/svelte-locale-picker": "0.2.0",
    "@lilydesignsystem/svelte-picker-bar": "0.3.0",
    "@lilydesignsystem/svelte-share-picker": "0.2.0",
    "@lilydesignsystem/svelte-text-size-picker": "0.2.0",
    "@lilydesignsystem/svelte-theme-picker": "0.2.0",
    "@lilydesignsystem/themes": "0.4.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
